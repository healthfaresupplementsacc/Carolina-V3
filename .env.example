# Slack
SLACK_BOT_TOKEN=xoxb-...           # Bot token OR user token para a conta do Bryce
SLACK_CHANNEL_ID=C09UNBXFRKK       # #orders-and-inventory
BRYCE_USER_ID=U09DQGJ1ES3          # ID da conta do Bryce no Slack

# Database (Railway preenche automaticamente com Postgres addon)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# App
PORT=3000
NODE_ENV=production
RAILWAY_STATIC_URL=                # URL pública do Railway (ex: https://healthfare.up.railway.app)

# Configurações
